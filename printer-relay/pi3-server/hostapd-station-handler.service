[Unit]
Description=Auto-flush ARP on WiFi station connect/disconnect
After=hostapd.service
Requires=hostapd.service

[Service]
Type=simple
ExecStart=/usr/sbin/hostapd_cli -i wlan_ap -p /var/run/hostapd -a /usr/local/sbin/hostapd-station-handler.sh
Restart=on-failure
RestartSec=10
StartLimitBurst=5
StartLimitIntervalSec=60

[Install]
WantedBy=multi-user.target
