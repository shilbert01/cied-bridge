[Unit]
Description=KardiSynch HID file sender (hub -> USB HID -> Windows companion)
After=kardisynch-gadget-hid.service network-online.target
Requires=kardisynch-gadget-hid.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/hid_sender.py
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
