# Copy to .env and fill in values before running docker compose up

# Shared secret — must match CENTRAL_TOKEN on all edge nodes
INGEST_TOKEN=changeme

# Paths inside the container (leave as-is unless you restructure volumes)
DATA_DIR=/data
DB_PATH=/data/db.sqlite

# BT PAN IP — used in cert SAN and for reference; pan0 is set up on the host
BT_PAN_IP=10.44.0.1

# --- KardiSynch outbox / Samba share -----------------------------------
# Password for the dedicated, non-guest SMB user "kardisynch". Auto-generated
# by install.sh on first setup — change here only if you need to rotate it.
KARDISYNCH_SMB_PASSWORD=changeme

# GID the outbox directory is chowned to (api container) and the Samba
# "kardisynch" account's primary group (must match compose.yaml's
# GROUPS_kardisynch mapping)
KARDISYNCH_SMB_GID=1000

# Outbox publisher poll interval (seconds)
KARDISYNCH_OUTBOX_INTERVAL=15

# Clinic-LAN IP of this Pi — SMB port 445 is bound ONLY here, not 0.0.0.0.
CENTRAL_LAN_IP=192.168.x.x
