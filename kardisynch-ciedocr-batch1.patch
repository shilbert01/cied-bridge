diff --git a/src/main/parsers/ciedocr-adapter.ts b/src/main/parsers/ciedocr-adapter.ts
new file mode 100644
--- /dev/null
+++ b/src/main/parsers/ciedocr-adapter.ts
@@ -0,0 +1,225 @@
+import { UnifiedReport, LeadData, Measurement, BatteryData } from '../reports';
+import { normalizeDate } from '../../lib/dates';
+import type { CiedocrEnvelope } from '../services/ciedocrClient';
+
+// Maps CIEDOcr extraction envelope → KardiSynch UnifiedReport.
+// Two schema families:
+//   flat  (pdfplumber vendors): impedance_a_ohm, sensing_rv_mv, battery_voltage_v, …
+//   nested (Abbott VQA):        test_rv.impedance_ohm, battery_rv.voltage, parameters.mode, …
+
+const VENDOR_MAP: Record<string, UnifiedReport['manufacturer']> = {
+  biotronik:          'Biotronik',
+  medtronic_2090:     'Medtronic',
+  medtronic_carelink: 'Medtronic',
+  abbott_log:         'Abbott',
+  abbott_merlin:      'Abbott',
+  bsc_crtd:           'Boston Scientific',
+  bsc_sicd:           'Boston Scientific',
+  ela_sorin:          'Microport',
+};
+
+function num(v: unknown): number | undefined {
+  if (v == null) return undefined;
+  if (typeof v === 'number') return v;
+  const s = String(v).replace(',', '.');
+  const m = /[-+]?\d+(?:\.\d+)?/.exec(s);
+  return m ? parseFloat(m[0]) : undefined;
+}
+
+function pw(threshold: unknown): number | undefined {
+  if (typeof threshold !== 'string') return undefined;
+  const m = /@\s*([-+]?\d+(?:[.,]\d+)?)/.exec(threshold);
+  return m ? parseFloat(m[1].replace(',', '.')) : undefined;
+}
+
+function meas(value: unknown, unit: string): Measurement | undefined {
+  const n = num(value);
+  return n != null ? { value: n, unit } : undefined;
+}
+
+function sec(report: Record<string, any>, block: string, key: string): unknown {
+  const b = report[block];
+  return b && typeof b === 'object' ? b[key] : undefined;
+}
+
+function first(report: Record<string, any>, ...keys: string[]): unknown {
+  for (const k of keys) {
+    const v = report[k];
+    if (v != null && v !== '' && !(Array.isArray(v) && v.length === 0)) return v;
+  }
+  return undefined;
+}
+
+function splitPatientName(report: Record<string, any>): { first_name: string; last_name: string } {
+  const raw = (report.patient_name || report.patient || '') as string;
+  if (!raw) return { first_name: '', last_name: '' };
+
+  // "Mustermann, Max" or "MUSTERMANN, MAX"
+  if (raw.includes(',')) {
+    const [last, ...rest] = raw.split(',');
+    return { last_name: last.trim(), first_name: rest.join(',').trim() };
+  }
+  // "MUSTERMANN MAX" — last word is first name (German convention)
+  const parts = raw.trim().split(/\s+/);
+  if (parts.length >= 2) {
+    return { last_name: parts.slice(0, -1).join(' '), first_name: parts[parts.length - 1] };
+  }
+  return { first_name: '', last_name: raw.trim() };
+}
+
+function inferManufacturer(report: Record<string, any>, engineName?: string): UnifiedReport['manufacturer'] {
+  if (engineName && VENDOR_MAP[engineName]) return VENDOR_MAP[engineName];
+
+  if (report.test_rv || report.test_ra || report.battery_rv || report.battery_ra) return 'Abbott';
+  const model = String(report.device_model || report.device || '').toLowerCase();
+  if (model.includes('medtronic') || model.includes('adapta') || model.includes('ensura')) return 'Medtronic';
+  if (model.includes('biotronik') || model.includes('edora') || model.includes('enitra')) return 'Biotronik';
+  if (model.includes('emblem') || model.includes('accolade') || model.includes('valitude')) return 'Boston Scientific';
+
+  return 'Unknown';
+}
+
+function buildLeads(report: Record<string, any>, deviceSerial?: string): LeadData[] {
+  const leads: LeadData[] = [];
+
+  // RA (atrial) — flat: *_a_*, nested: test_ra
+  const imp_ra = num(report.impedance_a_ohm) ?? num(sec(report, 'test_ra', 'impedance_ohm'));
+  const sens_ra = num(report.sensing_a_mv) ?? num(sec(report, 'test_ra', 'sensing_mv'));
+  const thr_ra_combined = sec(report, 'test_ra', 'pacing_threshold') as string | undefined;
+  const thr_ra_v = num(report.threshold_a_v) ?? num(report.threshold_ra_v)
+    ?? num(report.capture_threshold_a_v) ?? num(thr_ra_combined);
+  const thr_ra_pw = num(report.threshold_a_pw_ms) ?? num(report.threshold_ra_pw_ms)
+    ?? num(report.threshold_a_pulse_ms) ?? pw(thr_ra_combined);
+
+  if (imp_ra != null || sens_ra != null || thr_ra_v != null) {
+    const lead: LeadData = {
+      name: 'RA',
+      anatomic_location: 'Right Atrium',
+      impedance: meas(imp_ra, 'Ohm'),
+      sensing: meas(sens_ra, 'mV'),
+      pacing_threshold: thr_ra_v != null
+        ? { value: thr_ra_pw != null ? `${thr_ra_v} V @ ${thr_ra_pw} ms` : `${thr_ra_v}`, unit: 'V' }
+        : undefined,
+    };
+    if (deviceSerial) lead.device_serial = deviceSerial;
+    leads.push(lead);
+  }
+
+  // RV (right ventricle) — flat: *_rv_* or *_v_*, nested: test_rv
+  const imp_rv = num(report.impedance_rv_ohm) ?? num(report.impedance_v_ohm)
+    ?? num(sec(report, 'test_rv', 'impedance_ohm'));
+  const sens_rv = num(report.sensing_rv_mv) ?? num(report.sensing_v_mv)
+    ?? num(sec(report, 'test_rv', 'sensing_mv'));
+  const thr_rv_combined = sec(report, 'test_rv', 'pacing_threshold') as string | undefined;
+  const thr_rv_v = num(report.threshold_rv_v) ?? num(report.threshold_v_v)
+    ?? num(report.capture_threshold_rv_v) ?? num(thr_rv_combined);
+  const thr_rv_pw = num(report.pulse_width_rv_ms) ?? num(report.threshold_rv_pw_ms)
+    ?? num(report.threshold_rv_pulse_ms) ?? pw(thr_rv_combined);
+  const shock_rv = num(report.impedance_rv_defib_ohm);
+
+  if (imp_rv != null || sens_rv != null || thr_rv_v != null) {
+    const lead: LeadData = {
+      name: 'RV',
+      anatomic_location: 'Right Ventricle',
+      impedance: meas(imp_rv, 'Ohm'),
+      sensing: meas(sens_rv, 'mV'),
+      pacing_threshold: thr_rv_v != null
+        ? { value: thr_rv_pw != null ? `${thr_rv_v} V @ ${thr_rv_pw} ms` : `${thr_rv_v}`, unit: 'V' }
+        : undefined,
+      shock_impedance: meas(shock_rv, 'Ohm'),
+    };
+    if (deviceSerial) lead.device_serial = deviceSerial;
+    leads.push(lead);
+  }
+
+  // LV (left ventricle)
+  const imp_lv = num(report.impedance_lv_ohm);
+  const thr_lv_combined = sec(report, 'test_lv', 'pacing_threshold') as string | undefined;
+  const thr_lv_v = num(report.threshold_lv_v) ?? num(thr_lv_combined);
+  const thr_lv_pw = num(report.pulse_width_lv_ms) ?? num(report.threshold_lv_pw_ms)
+    ?? num(report.threshold_lv_pulse_ms) ?? pw(thr_lv_combined);
+
+  if (imp_lv != null || thr_lv_v != null) {
+    const lead: LeadData = {
+      name: 'LV',
+      anatomic_location: 'Left Ventricle',
+      impedance: meas(imp_lv, 'Ohm'),
+      pacing_threshold: thr_lv_v != null
+        ? { value: thr_lv_pw != null ? `${thr_lv_v} V @ ${thr_lv_pw} ms` : `${thr_lv_v}`, unit: 'V' }
+        : undefined,
+    };
+    if (deviceSerial) lead.device_serial = deviceSerial;
+    leads.push(lead);
+  }
+
+  return leads;
+}
+
+function buildBattery(report: Record<string, any>): BatteryData {
+  const voltage = num(report.battery_voltage_v)
+    ?? num(sec(report, 'battery_rv', 'voltage'))
+    ?? num(sec(report, 'battery_ra', 'voltage'));
+
+  const longevityRaw = first(report, 'battery_life', 'battery_status', 'battery_longevity')
+    ?? sec(report, 'battery_rv', 'estimated_longevity')
+    ?? sec(report, 'battery_ra', 'estimated_longevity');
+
+  const battery: BatteryData = {
+    voltage: meas(voltage, 'V'),
+  };
+
+  if (longevityRaw != null) {
+    battery.remaining_longevity = { value: String(longevityRaw), unit: '' };
+  }
+
+  if (voltage != null) {
+    if (voltage <= 2.5) battery.status = 'EOL';
+    else if (voltage <= 2.8) battery.status = 'ERI';
+    else battery.status = 'OK';
+  }
+
+  return battery;
+}
+
+function collectAdditionalFields(report: Record<string, any>): Record<string, string | number> | undefined {
+  const extra: Record<string, string | number> = {};
+
+  const mode = first(report, 'pacing_mode') ?? sec(report, 'parameters', 'mode');
+  if (mode != null) extra['Pacing Mode'] = String(mode);
+
+  const baseRate = first(report, 'base_rate_bpm') ?? sec(report, 'parameters', 'base_rate');
+  if (baseRate != null) extra['Base Rate (bpm)'] = num(baseRate) ?? String(baseRate);
+
+  return Object.keys(extra).length > 0 ? extra : undefined;
+}
+
+export function mapCiedocrToUnifiedReport(envelope: CiedocrEnvelope): UnifiedReport {
+  const report = envelope.report || {};
+  const engine = envelope.engine || {};
+  const deviceSerial = String(report.device_serial || '');
+  const patient = splitPatientName(report);
+
+  return {
+    manufacturer: inferManufacturer(report, engine.name),
+    interrogation_date: normalizeDate(
+      (first(report, 'interrogation_date', 'followup_date', 'implant_date') as string) || '',
+      'eu',
+    ),
+    patient: {
+      first_name: patient.first_name,
+      last_name: patient.last_name,
+      dob: normalizeDate((report.patient_dob || '') as string, 'eu'),
+      hospitalPatientId: report.patient_id || undefined,
+    },
+    device: {
+      type: (report.device_type as string) || 'Unknown',
+      model: String(first(report, 'device_model', 'device') || ''),
+      serial_number: deviceSerial,
+    },
+    battery: buildBattery(report),
+    leads: buildLeads(report, deviceSerial || undefined),
+    additional_fields: collectAdditionalFields(report),
+    formatVariant: `ciedocr:${engine.name || 'unknown'}`,
+    parseStatus: 'ok',
+  };
+}
