@@ -0,0 +1,155 @@
+import { net } from 'electron';
+import * as fs from 'fs/promises';
+import { getSettings } from '../database';
+
+export interface CiedocrConfig {
+  url: string;
+  token: string;
+  enabled: boolean;
+  strategy: 'fallback' | 'always';
+}
+
+export interface CiedocrEnvelope {
+  status: string;
+  report: Record<string, any>;
+  engine?: { name?: string; version?: string };
+  schema_version?: string;
+  request_id?: string;
+  detail?: string;
+}
+
+const POLL_INTERVAL_MS = 5000;
+const DEFAULT_TIMEOUT_MS = 300_000;
+
+async function getConfig(): Promise<CiedocrConfig> {
+  const settings = await getSettings();
+  return {
+    url: (settings.ciedocrUrl || '').replace(/\/+$/, ''),
+    token: settings.ciedocrToken || '',
+    enabled: settings.ciedocrEnabled === 'true',
+    strategy: (settings.ciedocrStrategy as 'fallback' | 'always') || 'fallback',
+  };
+}
+
+export async function isConfigured(): Promise<boolean> {
+  const cfg = await getConfig();
+  return cfg.enabled && !!cfg.url;
+}
+
+export async function getStrategy(): Promise<'fallback' | 'always'> {
+  const cfg = await getConfig();
+  return cfg.strategy;
+}
+
+function httpRequest(
+  url: string,
+  options: {
+    method?: string;
+    headers?: Record<string, string>;
+    body?: Buffer;
+    timeout?: number;
+  } = {}
+): Promise<{ status: number; body: string }> {
+  return new Promise((resolve, reject) => {
+    const req = net.request({
+      url,
+      method: options.method || 'GET',
+    });
+
+    if (options.headers) {
+      for (const [k, v] of Object.entries(options.headers)) {
+        req.setHeader(k, v);
+      }
+    }
+
+    const timer = setTimeout(() => {
+      req.abort();
+      reject(new Error(`Request to ${url} timed out`));
+    }, options.timeout || 30_000);
+
+    req.on('response', (response) => {
+      const chunks: Buffer[] = [];
+      response.on('data', (chunk: Buffer) => chunks.push(chunk));
+      response.on('end', () => {
+        clearTimeout(timer);
+        resolve({
+          status: response.statusCode,
+          body: Buffer.concat(chunks).toString('utf-8'),
+        });
+      });
+      response.on('error', (err) => {
+        clearTimeout(timer);
+        reject(err);
+      });
+    });
+
+    req.on('error', (err) => {
+      clearTimeout(timer);
+      reject(err);
+    });
+
+    if (options.body) {
+      req.write(options.body);
+    }
+    req.end();
+  });
+}
+
+export async function health(): Promise<boolean> {
+  const cfg = await getConfig();
+  if (!cfg.url) return false;
+  try {
+    const headers: Record<string, string> = {};
+    if (cfg.token) headers['Authorization'] = `Bearer ${cfg.token}`;
+    const res = await httpRequest(`${cfg.url}/health`, { headers, timeout: 8000 });
+    return res.status === 200;
+  } catch {
+    return false;
+  }
+}
+
+export async function extract(pdfPath: string, vendorHint?: string): Promise<CiedocrEnvelope> {
+  const cfg = await getConfig();
+  if (!cfg.url) throw new Error('CIEDOcr URL not configured');
+
+  const pdfData = await fs.readFile(pdfPath);
+  const headers: Record<string, string> = { 'Content-Type': 'application/pdf' };
+  if (cfg.token) headers['Authorization'] = `Bearer ${cfg.token}`;
+  if (vendorHint) headers['X-Vendor-Hint'] = vendorHint;
+
+  const submitRes = await httpRequest(`${cfg.url}/v1/extract?mode=async`, {
+    method: 'POST',
+    headers,
+    body: pdfData,
+    timeout: 30_000,
+  });
+
+  if (submitRes.status === 503) throw new Error('CIEDOcr service loading');
+  if (submitRes.status < 200 || submitRes.status >= 300) {
+    throw new Error(`CIEDOcr submit rejected (HTTP ${submitRes.status})`);
+  }
+
+  const submit = JSON.parse(submitRes.body);
+  const pollUrl = cfg.url + (submit.poll || `/v1/jobs/${submit.job_id}`);
+  const pollHeaders: Record<string, string> = {};
+  if (cfg.token) pollHeaders['Authorization'] = `Bearer ${cfg.token}`;
+
+  const deadline = Date.now() + DEFAULT_TIMEOUT_MS;
+  while (Date.now() < deadline) {
+    await new Promise(r => setTimeout(r, POLL_INTERVAL_MS));
+
+    const pollRes = await httpRequest(pollUrl, { headers: pollHeaders, timeout: 15_000 });
+    if (pollRes.status === 404) throw new Error('CIEDOcr job expired or unknown');
+    if (pollRes.status < 200 || pollRes.status >= 300) {
+      throw new Error(`CIEDOcr poll failed (HTTP ${pollRes.status})`);
+    }
+
+    const res: CiedocrEnvelope = JSON.parse(pollRes.body);
+    if (res.status === 'queued' || res.status === 'running') continue;
+    if (res.status === 'ok') return res;
+    if (res.status === 'no_text') throw new Error('CIEDOcr: no extractable text in PDF');
+    throw new Error(res.detail || `CIEDOcr: unexpected status "${res.status}"`);
+  }
+
+  throw new Error('CIEDOcr extraction timed out');
+}
