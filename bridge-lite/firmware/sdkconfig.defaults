# CIED Bridge Lite — ESP32-S3 T-Dongle-S3 defaults

# Target
CONFIG_IDF_TARGET="esp32s3"

# Flash — T-Dongle-S3 has 16MB QIO
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# Partition table — single factory app + NVS
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# USB — TinyUSB device mode with MSC
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_USB_OTG_SUPPORTED=y

# FATFS — long filenames required (the ThingPulse LFN lesson)
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# SDMMC
CONFIG_SOC_SDMMC_HOST_SUPPORTED=y

# WiFi — SoftAP for receiver, STA for sender
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# Default role: sender (override with menuconfig)
CONFIG_BRIDGE_LITE_ROLE_SENDER=y

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# No PSRAM on T-Dongle-S3
# CONFIG_SPIRAM is not set
